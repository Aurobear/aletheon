[Unit]
Description=Aletheon per-user runtime
After=network.target

[Service]
Type=simple
ExecStart=%h/.local/bin/aletheon daemon
Restart=on-failure
RestartSec=5
Environment=RUST_LOG=info
# User-mode coding tools are discovered through the user's conventional binary
# roots. The sandbox forwards this PATH but retains a read-only host root and
# only grants writes to the active WorkspacePolicy.
Environment=PATH=%h/.local/bin:%h/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
StateDirectory=aletheon
CacheDirectory=aletheon

# The runtime deliberately retains the invoking user's filesystem authority.
# Per-turn WorkspacePolicy and bubblewrap narrow that authority dynamically.
NoNewPrivileges=yes
LimitCORE=0
