{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SessionProtocolV5",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "data": {
          "$ref": "#/$defs/SessionRecord"
        },
        "type": {
          "type": "string",
          "const": "session"
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "type": "object",
      "properties": {
        "data": {
          "$ref": "#/$defs/TurnRecord"
        },
        "type": {
          "type": "string",
          "const": "turn"
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "type": "object",
      "properties": {
        "data": {
          "$ref": "#/$defs/ItemRecord"
        },
        "type": {
          "type": "string",
          "const": "item"
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "type": "object",
      "properties": {
        "data": {
          "$ref": "#/$defs/SessionNotification"
        },
        "type": {
          "type": "string",
          "const": "notification"
        }
      },
      "required": [
        "type",
        "data"
      ]
    }
  ],
  "$defs": {
    "CacheTelemetry": {
      "type": "string",
      "enum": [
        "reported",
        "unsupported",
        "unknown"
      ]
    },
    "CapabilityErrorClass": {
      "type": "string",
      "enum": [
        "implementation",
        "environment",
        "dependency",
        "permission",
        "provider",
        "timeout",
        "concurrent_modification",
        "invalid_request",
        "unknown"
      ]
    },
    "CapabilityRetryDisposition": {
      "type": "string",
      "enum": [
        "never",
        "after_backoff",
        "after_correction"
      ]
    },
    "CapabilityTerminalReceipt": {
      "description": "Authoritative terminal evidence projected by the host after a capability\ninvocation reaches a terminal state. Submission/progress events never\nconstruct this receipt.",
      "type": "object",
      "properties": {
        "artifact_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "audit_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "capability": {
          "type": "string"
        },
        "error_class": {
          "anyOf": [
            {
              "$ref": "#/$defs/CapabilityErrorClass"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        },
        "finished_at": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "invocation_id": {
          "type": "string"
        },
        "operation_id": {
          "$ref": "#/$defs/OperationId"
        },
        "output_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "process_id": {
          "type": "string",
          "format": "uuid"
        },
        "retry_disposition": {
          "$ref": "#/$defs/CapabilityRetryDisposition"
        },
        "started_at": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "status": {
          "$ref": "#/$defs/CapabilityTerminalStatus"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "invocation_id",
        "operation_id",
        "process_id",
        "capability",
        "status",
        "started_at",
        "finished_at",
        "artifact_ids",
        "evidence_ids",
        "truncated",
        "retry_disposition"
      ]
    },
    "CapabilityTerminalStatus": {
      "type": "string",
      "enum": [
        "succeeded",
        "failed",
        "cancelled",
        "timed_out"
      ]
    },
    "EvaluationDecision": {
      "type": "string",
      "enum": [
        "observed_pass",
        "observed_fail",
        "accepted",
        "rejected",
        "indeterminate"
      ]
    },
    "EvaluationReceiptRef": {
      "type": "object",
      "properties": {
        "confidence_millis": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "contract_id": {
          "type": "string",
          "format": "uuid"
        },
        "created_at_ms": {
          "type": "integer",
          "format": "int64"
        },
        "decision": {
          "$ref": "#/$defs/EvaluationDecision"
        },
        "evidence_coverage_millis": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "failed_gates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "receipt_id": {
          "type": "string",
          "format": "uuid"
        },
        "schema_version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "subject_id": {
          "type": "string"
        },
        "subject_kind": {
          "type": "string"
        },
        "weighted_total_millis": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "schema_version",
        "receipt_id",
        "contract_id",
        "subject_kind",
        "subject_id",
        "decision",
        "evidence_coverage_millis",
        "confidence_millis",
        "failed_gates",
        "created_at_ms"
      ]
    },
    "InferenceTerminalReceipt": {
      "type": "object",
      "properties": {
        "active_context_occupancy_tokens": {
          "description": "Prompt tokens actually submitted for this inference round. This is\nactive occupancy, not cumulative billed usage across the Session.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "context_capacity_tokens": {
          "description": "Selected model context capacity observed by the Host/provider adapter.\nOptional for backward compatibility with persisted v1 receipts.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "failure_kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "inference_id": {
          "type": "string"
        },
        "local_cache_miss_reason": {
          "description": "Host-side explanation for a changed stable prefix, or the conservative\n`provider_miss_or_eviction` inference when the shape stayed identical.",
          "type": [
            "string",
            "null"
          ]
        },
        "model_id": {
          "type": "string"
        },
        "operation_id": {
          "type": "string"
        },
        "prefix_shape_digest": {
          "description": "Diagnostic identity of the cache-relevant request prefix (see\n`executive::host::daemon::cache_shape::InferencePrefixShape::digest`).\nHost-side diagnostic only; never a correctness dependency and never a\nclaim that the provider hit or missed cache. `None` when the host did\nnot compute a shape for this turn.",
          "type": [
            "string",
            "null"
          ]
        },
        "provider_id": {
          "type": "string"
        },
        "schema_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "status": {
          "$ref": "#/$defs/InferenceTerminalStatus"
        },
        "system_prefix_digest": {
          "type": "string"
        },
        "tool_schema_digest": {
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/InferenceUsage"
        }
      },
      "required": [
        "schema_version",
        "inference_id",
        "operation_id",
        "provider_id",
        "model_id",
        "system_prefix_digest",
        "tool_schema_digest",
        "status",
        "usage"
      ]
    },
    "InferenceTerminalStatus": {
      "type": "string",
      "enum": [
        "succeeded",
        "failed",
        "cancelled",
        "timed_out"
      ]
    },
    "InferenceUsage": {
      "type": "object",
      "properties": {
        "cache_read_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "default": null,
          "minimum": 0
        },
        "cache_telemetry": {
          "$ref": "#/$defs/CacheTelemetry",
          "default": "unknown"
        },
        "cache_write_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "default": null,
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "default": null,
          "minimum": 0
        },
        "total_input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "default": null,
          "minimum": 0
        },
        "uncached_input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "default": null,
          "minimum": 0
        }
      }
    },
    "ItemPayload": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "content": {
                  "type": "string"
                }
              },
              "required": [
                "content"
              ]
            },
            "type": {
              "type": "string",
              "const": "user_message"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "content": {
                  "type": "string"
                }
              },
              "required": [
                "content"
              ]
            },
            "type": {
              "type": "string",
              "const": "assistant_message"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "call_id": {
                  "type": "string"
                },
                "input": true,
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "call_id",
                "name",
                "input"
              ]
            },
            "type": {
              "type": "string",
              "const": "tool_call"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "audit_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "uuid"
                },
                "call_id": {
                  "type": "string"
                },
                "content": {
                  "type": "string"
                },
                "is_error": {
                  "type": "boolean"
                },
                "permit_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "uuid"
                }
              },
              "required": [
                "call_id",
                "content",
                "is_error"
              ]
            },
            "type": {
              "type": "string",
              "const": "tool_result"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "receipt": {
                  "$ref": "#/$defs/CapabilityTerminalReceipt"
                }
              },
              "required": [
                "receipt"
              ]
            },
            "type": {
              "type": "string",
              "const": "capability_receipt"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "description": "Immutable Robot-domain terminal receipt. The report contains only\nbounded typed facts and external artifact references; image/log bytes are\nnever embedded in the Session journal.",
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "receipt": true
              },
              "required": [
                "receipt"
              ]
            },
            "type": {
              "type": "string",
              "const": "robot_episode_receipt"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "receipt": {
                  "$ref": "#/$defs/EvaluationReceiptRef"
                }
              },
              "required": [
                "receipt"
              ]
            },
            "type": {
              "type": "string",
              "const": "evaluation_receipt_ref"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "receipt": {
                  "$ref": "#/$defs/ModelContextProjectionReceipt"
                }
              },
              "required": [
                "receipt"
              ]
            },
            "type": {
              "type": "string",
              "const": "model_context_projection"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "receipt": {
                  "$ref": "#/$defs/InferenceTerminalReceipt"
                }
              },
              "required": [
                "receipt"
              ]
            },
            "type": {
              "type": "string",
              "const": "inference_receipt"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "fact": {
                  "$ref": "#/$defs/TaskProjectionFact"
                }
              },
              "required": [
                "fact"
              ]
            },
            "type": {
              "type": "string",
              "const": "task_projection"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "classification": {
                  "$ref": "#/$defs/TurnRecoveryClassification"
                }
              },
              "required": [
                "classification"
              ]
            },
            "type": {
              "type": "string",
              "const": "turn_recovery"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "broadcast_epoch": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "format": "uint64",
                  "minimum": 0
                },
                "content_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "dasein_version": {
                  "type": "integer",
                  "format": "uint64",
                  "minimum": 0
                },
                "space": {
                  "type": "string"
                },
                "workspace_version": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "format": "uint64",
                  "minimum": 0
                }
              },
              "required": [
                "space",
                "dasein_version",
                "content_ids"
              ]
            },
            "type": {
              "type": "string",
              "const": "context_projection"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "content": {
                  "type": "string"
                }
              },
              "required": [
                "content"
              ]
            },
            "type": {
              "type": "string",
              "const": "system_notice"
            }
          },
          "required": [
            "type",
            "data"
          ]
        }
      ]
    },
    "ItemRecord": {
      "type": "object",
      "properties": {
        "created_at_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "payload": {
          "$ref": "#/$defs/ItemPayload"
        },
        "schema_version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "sequence": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "session_id": {
          "type": "string"
        },
        "turn_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "schema_version",
        "id",
        "session_id",
        "turn_id",
        "sequence",
        "created_at_ms",
        "payload"
      ]
    },
    "ModelContextClassification": {
      "type": "string",
      "enum": [
        "instruction",
        "trusted_runtime",
        "untrusted_input",
        "model_history",
        "tool_evidence"
      ]
    },
    "ModelContextFragmentReceipt": {
      "type": "object",
      "properties": {
        "artifact_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "classification": {
          "$ref": "#/$defs/ModelContextClassification"
        },
        "fragment_id": {
          "type": "string"
        },
        "inline_content": {
          "description": "Present only while crossing the trusted persistence adapter. Canonical\nsession receipts replace it with `artifact_ref` before append.",
          "type": [
            "string",
            "null"
          ]
        },
        "selection_reason": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "source_version": {
          "type": "string"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "fragment_id",
        "source",
        "source_version",
        "selection_reason",
        "classification",
        "truncated",
        "bytes"
      ]
    },
    "ModelContextProjectionReceipt": {
      "type": "object",
      "properties": {
        "fragments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ModelContextFragmentReceipt"
          }
        },
        "inference_id": {
          "type": "string"
        },
        "message_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "omitted_fragment_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "operation_id": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "stage": {
          "type": "string"
        },
        "system_prefix_digest": {
          "type": "string"
        },
        "task_node_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "tool_schema_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "tool_schema_digest": {
          "type": "string"
        }
      },
      "required": [
        "inference_id",
        "operation_id",
        "system_prefix_digest",
        "tool_schema_digest",
        "role",
        "stage",
        "fragments",
        "omitted_fragment_ids",
        "message_bytes",
        "tool_schema_bytes"
      ]
    },
    "OperationId": {
      "type": "string",
      "format": "uuid"
    },
    "SessionFork": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string"
        },
        "through_sequence": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "session_id",
        "through_sequence"
      ]
    },
    "SessionNotification": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "item": {
                  "$ref": "#/$defs/ItemRecord"
                },
                "schema_version": {
                  "type": "integer",
                  "format": "uint16",
                  "maximum": 65535,
                  "minimum": 0
                }
              },
              "required": [
                "schema_version",
                "item"
              ]
            },
            "type": {
              "type": "string",
              "const": "item_appended"
            }
          },
          "required": [
            "type",
            "data"
          ]
        }
      ]
    },
    "SessionRecord": {
      "type": "object",
      "properties": {
        "created_at_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "id": {
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionFork"
            },
            {
              "type": "null"
            }
          ]
        },
        "schema_version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "status": {
          "$ref": "#/$defs/SessionStatus"
        }
      },
      "required": [
        "schema_version",
        "id",
        "created_at_ms",
        "status"
      ]
    },
    "SessionStatus": {
      "type": "string",
      "enum": [
        "active",
        "interrupted",
        "completed",
        "failed"
      ]
    },
    "TaskProjectionFact": {
      "description": "Host-authored durable Task read-model inputs. These facts are replayed with\nSession items so restart recovery never depends on process-local UI state or\nmodel self-reporting.",
      "type": "object",
      "properties": {
        "active_commands": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "active_runtime_children": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "budget": true,
        "checkpoint_head": {
          "type": [
            "string",
            "null"
          ]
        },
        "pending_approvals": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "plan_revision": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "schema_version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "required": [
        "schema_version"
      ]
    },
    "TurnRecord": {
      "type": "object",
      "properties": {
        "completed_at_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "operation_id": {
          "type": "string",
          "format": "uuid"
        },
        "schema_version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "session_id": {
          "type": "string"
        },
        "started_at_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "stop": {
          "anyOf": [
            {
              "$ref": "#/$defs/TurnStop"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "id",
        "session_id",
        "operation_id",
        "started_at_ms"
      ]
    },
    "TurnRecoveryClassification": {
      "description": "Host classification written when startup recovery finds a turn that has a\ndurable start boundary but no terminal fact. This is a Session journal fact,\nnot a process-local recovery marker.",
      "type": "string",
      "enum": [
        "interrupted",
        "failed"
      ]
    },
    "TurnStop": {
      "type": "string",
      "enum": [
        "Completed",
        "Blocked",
        "Cancelled",
        "Failed"
      ]
    }
  }
}
