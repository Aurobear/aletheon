{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SessionProtocolV5",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "data": {
          "$ref": "#/$defs/SessionRecord"
        },
        "type": {
          "type": "string",
          "const": "session"
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "type": "object",
      "properties": {
        "data": {
          "$ref": "#/$defs/TurnRecord"
        },
        "type": {
          "type": "string",
          "const": "turn"
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "type": "object",
      "properties": {
        "data": {
          "$ref": "#/$defs/ItemRecord"
        },
        "type": {
          "type": "string",
          "const": "item"
        }
      },
      "required": [
        "type",
        "data"
      ]
    },
    {
      "type": "object",
      "properties": {
        "data": {
          "$ref": "#/$defs/SessionNotification"
        },
        "type": {
          "type": "string",
          "const": "notification"
        }
      },
      "required": [
        "type",
        "data"
      ]
    }
  ],
  "$defs": {
    "BudgetMissingReason": {
      "type": "string",
      "enum": [
        "no_active_agent_rollout",
        "runtime_scope_not_reported",
        "source_unavailable"
      ]
    },
    "CacheTelemetry": {
      "type": "string",
      "enum": [
        "reported",
        "unsupported",
        "unknown"
      ]
    },
    "CapabilityErrorClass": {
      "type": "string",
      "enum": [
        "implementation",
        "environment",
        "dependency",
        "permission",
        "provider",
        "timeout",
        "concurrent_modification",
        "invalid_request",
        "unknown"
      ]
    },
    "CapabilityRetryDisposition": {
      "type": "string",
      "enum": [
        "never",
        "after_backoff",
        "after_correction"
      ]
    },
    "CapabilityTerminalReceipt": {
      "description": "Authoritative terminal evidence projected by the host after a capability\ninvocation reaches a terminal state. Submission/progress events never\nconstruct this receipt.",
      "type": "object",
      "properties": {
        "artifact_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "audit_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "capability": {
          "type": "string"
        },
        "error_class": {
          "anyOf": [
            {
              "$ref": "#/$defs/CapabilityErrorClass"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        },
        "finished_at": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "invocation_id": {
          "type": "string"
        },
        "operation_id": {
          "$ref": "#/$defs/OperationId"
        },
        "output_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "process_id": {
          "type": "string",
          "format": "uuid"
        },
        "retry_disposition": {
          "$ref": "#/$defs/CapabilityRetryDisposition"
        },
        "started_at": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "status": {
          "$ref": "#/$defs/CapabilityTerminalStatus"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "invocation_id",
        "operation_id",
        "process_id",
        "capability",
        "status",
        "started_at",
        "finished_at",
        "artifact_ids",
        "evidence_ids",
        "truncated",
        "retry_disposition"
      ]
    },
    "CapabilityTerminalStatus": {
      "type": "string",
      "enum": [
        "succeeded",
        "failed",
        "cancelled",
        "timed_out"
      ]
    },
    "ContextBudgetProjection": {
      "description": "One authoritative per-turn snapshot. Context values are request-scoped;\n`rollout` values are cumulative and deliberately use a separate newtype.",
      "type": "object",
      "properties": {
        "admissible_history_tokens": {
          "$ref": "#/$defs/HistoryBudgetTokens"
        },
        "compaction_threshold_tokens": {
          "$ref": "#/$defs/HistoryBudgetTokens"
        },
        "current_history_tokens": {
          "$ref": "#/$defs/HistoryTokens"
        },
        "history_source": {
          "$ref": "#/$defs/ContextBudgetSource"
        },
        "model_context_tokens": {
          "$ref": "#/$defs/ModelContextWindowTokens"
        },
        "model_source": {
          "$ref": "#/$defs/ContextBudgetSource"
        },
        "model_spec": {
          "type": "string"
        },
        "pending_input_tokens": {
          "$ref": "#/$defs/HistoryTokens"
        },
        "profile_input_limit_tokens": {
          "$ref": "#/$defs/ProfileInputLimitTokens"
        },
        "profile_source": {
          "$ref": "#/$defs/ContextBudgetSource"
        },
        "reserved_output_tokens": {
          "$ref": "#/$defs/ContextCostTokens"
        },
        "rollout": {
          "$ref": "#/$defs/RolloutBudgetProjection"
        },
        "safety_margin_tokens": {
          "$ref": "#/$defs/ContextCostTokens"
        },
        "system_and_skill_tokens": {
          "$ref": "#/$defs/ContextCostTokens"
        },
        "tool_schema_tokens": {
          "$ref": "#/$defs/ContextCostTokens"
        }
      },
      "required": [
        "model_spec",
        "model_context_tokens",
        "profile_input_limit_tokens",
        "reserved_output_tokens",
        "system_and_skill_tokens",
        "tool_schema_tokens",
        "pending_input_tokens",
        "safety_margin_tokens",
        "current_history_tokens",
        "admissible_history_tokens",
        "compaction_threshold_tokens",
        "model_source",
        "profile_source",
        "history_source",
        "rollout"
      ]
    },
    "ContextBudgetSource": {
      "description": "Secret-safe description of the authority for a projected value.",
      "type": "object",
      "properties": {
        "digest_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/ContextBudgetSourceKind"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "label"
      ]
    },
    "ContextBudgetSourceKind": {
      "type": "string",
      "enum": [
        "runtime_model_capability",
        "active_agent_profile",
        "context_budget_planner",
        "effective_admission_config",
        "agent_runtime"
      ]
    },
    "ContextCompactionMode": {
      "type": "string",
      "enum": [
        "preflight",
        "automatic"
      ]
    },
    "ContextCompactionProjection": {
      "description": "Durable evidence for one applied context compaction.",
      "type": "object",
      "properties": {
        "budget_snapshot": {
          "$ref": "#/$defs/ContextBudgetProjection"
        },
        "mode": {
          "$ref": "#/$defs/ContextCompactionMode"
        },
        "tokens_after": {
          "$ref": "#/$defs/HistoryTokens"
        },
        "tokens_before": {
          "$ref": "#/$defs/HistoryTokens"
        },
        "trigger_threshold_tokens": {
          "$ref": "#/$defs/HistoryBudgetTokens"
        }
      },
      "required": [
        "mode",
        "trigger_threshold_tokens",
        "tokens_before",
        "tokens_after",
        "budget_snapshot"
      ]
    },
    "ContextCostTokens": {
      "description": "Tokens consumed or reserved by one non-history context component.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "DeviceId": {
      "type": "string"
    },
    "EvaluationDecision": {
      "type": "string",
      "enum": [
        "observed_pass",
        "observed_fail",
        "accepted",
        "rejected",
        "indeterminate"
      ]
    },
    "EvaluationReceiptRef": {
      "type": "object",
      "properties": {
        "confidence_millis": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "contract_id": {
          "type": "string",
          "format": "uuid"
        },
        "created_at_ms": {
          "type": "integer",
          "format": "int64"
        },
        "decision": {
          "$ref": "#/$defs/EvaluationDecision"
        },
        "evidence_coverage_millis": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "failed_gates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "receipt_id": {
          "type": "string",
          "format": "uuid"
        },
        "schema_version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "subject_id": {
          "type": "string"
        },
        "subject_kind": {
          "type": "string"
        },
        "weighted_total_millis": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "schema_version",
        "receipt_id",
        "contract_id",
        "subject_kind",
        "subject_id",
        "decision",
        "evidence_coverage_millis",
        "confidence_millis",
        "failed_gates",
        "created_at_ms"
      ]
    },
    "ExecutionEnvironment": {
      "description": "Provider-attested execution environment. The value comes from the device\nprovider capability handshake; operator configuration may only state the\nenvironment it expects and cannot upgrade this fact.",
      "type": "string",
      "enum": [
        "simulation",
        "hil",
        "real"
      ]
    },
    "ExecutionTarget": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "general"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "device_id": {
              "$ref": "#/$defs/DeviceId"
            },
            "environment": {
              "$ref": "#/$defs/ExecutionEnvironment"
            },
            "kind": {
              "type": "string",
              "const": "robot"
            }
          },
          "required": [
            "kind",
            "device_id",
            "environment"
          ]
        }
      ]
    },
    "ExecutionTargetSelection": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/$defs/ExecutionTargetSource",
          "default": "default"
        },
        "target": {
          "$ref": "#/$defs/ExecutionTarget",
          "default": {
            "kind": "general"
          }
        }
      }
    },
    "ExecutionTargetSource": {
      "description": "Auditable provenance for the typed target selection.",
      "oneOf": [
        {
          "description": "Backward-compatible/default path. This source may select only General.",
          "type": "string",
          "const": "default"
        },
        {
          "description": "Explicit local UI command such as `/target robot <device>`.",
          "type": "string",
          "const": "user_command"
        },
        {
          "description": "Explicit typed field supplied by an authenticated trusted client.",
          "type": "string",
          "const": "trusted_client"
        }
      ]
    },
    "HistoryBudgetTokens": {
      "description": "Capacity made available to conversation history for one request.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "HistoryTokens": {
      "description": "Observed or projected conversation-history tokens for one request.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "InferenceTerminalReceipt": {
      "type": "object",
      "properties": {
        "active_context_occupancy_tokens": {
          "description": "Prompt tokens actually submitted for this inference round. This is\nactive occupancy, not cumulative billed usage across the Session.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "context_capacity_tokens": {
          "description": "Selected model context capacity observed by the Host/provider adapter.\nOptional for backward compatibility with persisted v1 receipts.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "failure_kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "inference_id": {
          "type": "string"
        },
        "local_cache_miss_reason": {
          "description": "Host-side explanation for a changed stable prefix, or the conservative\n`provider_miss_or_eviction` inference when the shape stayed identical.",
          "type": [
            "string",
            "null"
          ]
        },
        "model_id": {
          "type": "string"
        },
        "operation_id": {
          "type": "string"
        },
        "prefix_shape_digest": {
          "description": "Diagnostic identity of the cache-relevant request prefix (see\n`executive::host::daemon::cache_shape::InferencePrefixShape::digest`).\nHost-side diagnostic only; never a correctness dependency and never a\nclaim that the provider hit or missed cache. `None` when the host did\nnot compute a shape for this turn.",
          "type": [
            "string",
            "null"
          ]
        },
        "provider_id": {
          "type": "string"
        },
        "schema_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "status": {
          "$ref": "#/$defs/InferenceTerminalStatus"
        },
        "system_prefix_digest": {
          "type": "string"
        },
        "tool_schema_digest": {
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/InferenceUsage"
        }
      },
      "required": [
        "schema_version",
        "inference_id",
        "operation_id",
        "provider_id",
        "model_id",
        "system_prefix_digest",
        "tool_schema_digest",
        "status",
        "usage"
      ]
    },
    "InferenceTerminalStatus": {
      "type": "string",
      "enum": [
        "succeeded",
        "failed",
        "cancelled",
        "timed_out"
      ]
    },
    "InferenceUsage": {
      "type": "object",
      "properties": {
        "cache_read_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "default": null,
          "minimum": 0
        },
        "cache_telemetry": {
          "$ref": "#/$defs/CacheTelemetry",
          "default": "unknown"
        },
        "cache_write_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "default": null,
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "default": null,
          "minimum": 0
        },
        "total_input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "default": null,
          "minimum": 0
        },
        "uncached_input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "default": null,
          "minimum": 0
        }
      }
    },
    "ItemPayload": {
      "oneOf": [
        {
          "description": "Authoritative per-turn start fact. The typed target is stored on the\nexisting durable start boundary so replay cannot inherit a prior turn's\ntarget. Legacy items decode as General.",
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "content": {
                  "type": "string"
                },
                "execution_target": {
                  "$ref": "#/$defs/ExecutionTargetSelection",
                  "default": {
                    "source": "default",
                    "target": {
                      "kind": "general"
                    }
                  }
                }
              },
              "required": [
                "content"
              ]
            },
            "type": {
              "type": "string",
              "const": "user_message"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "content": {
                  "type": "string"
                }
              },
              "required": [
                "content"
              ]
            },
            "type": {
              "type": "string",
              "const": "assistant_message"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "call_id": {
                  "type": "string"
                },
                "input": true,
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "call_id",
                "name",
                "input"
              ]
            },
            "type": {
              "type": "string",
              "const": "tool_call"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "audit_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "uuid"
                },
                "call_id": {
                  "type": "string"
                },
                "content": {
                  "type": "string"
                },
                "is_error": {
                  "type": "boolean"
                },
                "permit_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "uuid"
                }
              },
              "required": [
                "call_id",
                "content",
                "is_error"
              ]
            },
            "type": {
              "type": "string",
              "const": "tool_result"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "receipt": {
                  "$ref": "#/$defs/CapabilityTerminalReceipt"
                }
              },
              "required": [
                "receipt"
              ]
            },
            "type": {
              "type": "string",
              "const": "capability_receipt"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "description": "Immutable Robot-domain terminal receipt. The report contains only\nbounded typed facts and external artifact references; image/log bytes are\nnever embedded in the Session journal.",
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "receipt": true
              },
              "required": [
                "receipt"
              ]
            },
            "type": {
              "type": "string",
              "const": "robot_episode_receipt"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "receipt": {
                  "$ref": "#/$defs/EvaluationReceiptRef"
                }
              },
              "required": [
                "receipt"
              ]
            },
            "type": {
              "type": "string",
              "const": "evaluation_receipt_ref"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "receipt": {
                  "$ref": "#/$defs/ModelContextProjectionReceipt"
                }
              },
              "required": [
                "receipt"
              ]
            },
            "type": {
              "type": "string",
              "const": "model_context_projection"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "description": "Host-authoritative model/profile/history/rollout budget truth for this\nturn. It is computed before inference from the selected model and the\nexact prepared context.",
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "projection": {
                  "$ref": "#/$defs/ContextBudgetProjection"
                }
              },
              "required": [
                "projection"
              ]
            },
            "type": {
              "type": "string",
              "const": "context_budget_projection"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "description": "Evidence for an applied history rewrite, including its triggering budget.",
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "projection": {
                  "$ref": "#/$defs/ContextCompactionProjection"
                }
              },
              "required": [
                "projection"
              ]
            },
            "type": {
              "type": "string",
              "const": "context_compaction_projection"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "receipt": {
                  "$ref": "#/$defs/InferenceTerminalReceipt"
                }
              },
              "required": [
                "receipt"
              ]
            },
            "type": {
              "type": "string",
              "const": "inference_receipt"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "fact": {
                  "$ref": "#/$defs/TaskProjectionFact"
                }
              },
              "required": [
                "fact"
              ]
            },
            "type": {
              "type": "string",
              "const": "task_projection"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "classification": {
                  "$ref": "#/$defs/TurnRecoveryClassification"
                }
              },
              "required": [
                "classification"
              ]
            },
            "type": {
              "type": "string",
              "const": "turn_recovery"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "description": "Authoritative terminal fact for an ordinarily executed turn. This is\ndistinct from `TurnRecovery`, which is reserved for startup recovery of\na turn whose terminal boundary was missing.",
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "content": {
                  "type": "string"
                },
                "status": {
                  "$ref": "#/$defs/TurnTerminalStatus"
                }
              },
              "required": [
                "status",
                "content"
              ]
            },
            "type": {
              "type": "string",
              "const": "turn_settlement"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
